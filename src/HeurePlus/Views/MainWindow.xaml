<Window x:Class="HeurePlus.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:HeurePlus.Views"
        Title="Heure+" Height="860" Width="1240" MinHeight="640" MinWidth="1000"
        Icon="/HeurePlus;component/heureplus.ico"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource Font.Text}" FontSize="14" Language="fr-FR"
        Background="{DynamicResource Brush.Bg}"
        TextElement.Foreground="{DynamicResource Brush.Text}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= Rail de navigation ================= -->
        <Border Grid.Column="0" Background="{DynamicResource Brush.NavRailBg}"
                BorderBrush="{DynamicResource Brush.DividerStroke}" BorderThickness="0,0,1,0">
            <DockPanel>

                <!-- Marque -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="18,22,18,20">
                    <Image Source="/HeurePlus;component/heureplus.ico" Width="30" Height="30"
                           RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Heure+" FontFamily="{StaticResource Font.Display}"
                                   FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Suivi des missions" FontSize="11"
                                   Foreground="{DynamicResource Brush.TextTertiary}" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Pied : bascule de thème -->
                <Border DockPanel.Dock="Bottom" Margin="14,10,14,16">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="{StaticResource Font.Icons}" Text="&#xE706;" FontSize="14"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}" />
                            <TextBlock Text="Thème sombre" Margin="10,0,0,0" VerticalAlignment="Center"
                                       FontSize="13" Foreground="{DynamicResource Brush.TextMuted}" />
                        </StackPanel>
                        <ToggleButton Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                                      VerticalAlignment="Center" IsChecked="{Binding Settings.IsDark}" />
                    </Grid>
                </Border>

                <!-- Éléments -->
                <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,2,0,0"
                         ItemContainerStyle="{StaticResource NavItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectedIndex="{Binding SelectedTab, Mode=TwoWay}">
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource Font.Icons}" Text="&#xE787;" FontSize="16" Width="22" />
                            <TextBlock Text="Calendrier" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource Font.Icons}" Text="&#xE825;" FontSize="16" Width="22" />
                            <TextBlock Text="Salaire" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource Font.Icons}" Text="&#xE1D0;" FontSize="16" Width="22" />
                            <TextBlock Text="Calculatrice" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource Font.Icons}" Text="&#xE9D9;" FontSize="16" Width="22" />
                            <TextBlock Text="Tableau de bord" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource Font.Icons}" Text="&#xE713;" FontSize="16" Width="22" />
                            <TextBlock Text="Réglages" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ================= Contenu ================= -->
        <Grid Grid.Column="1" Background="{DynamicResource Brush.Layer}">
            <views:CalendarView DataContext="{Binding Calendar}"
                                Visibility="{Binding DataContext.SelectedTab, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IndexToVis}, ConverterParameter=0}" />
            <views:SalaryView DataContext="{Binding Salary}"
                              Visibility="{Binding DataContext.SelectedTab, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IndexToVis}, ConverterParameter=1}" />
            <views:CalculatorView DataContext="{Binding Calculator}"
                                  Visibility="{Binding DataContext.SelectedTab, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IndexToVis}, ConverterParameter=2}" />
            <views:DashboardView DataContext="{Binding Dashboard}"
                                 Visibility="{Binding DataContext.SelectedTab, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IndexToVis}, ConverterParameter=3}" />
            <views:SettingsView DataContext="{Binding Settings}"
                                Visibility="{Binding DataContext.SelectedTab, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IndexToVis}, ConverterParameter=4}" />
        </Grid>
    </Grid>
</Window>
