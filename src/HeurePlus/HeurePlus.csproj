<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <RootNamespace>HeurePlus</RootNamespace>
    <AssemblyName>HeurePlus</AssemblyName>
    <!-- Version unique de l'application : lue par l'app (À propos / mise à jour)
         ET par l'installeur (build-installer.ps1 la passe à Inno Setup). -->
    <Version>0.5.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Heure+</Product>
    <Authors>Heure+</Authors>
    <AssemblyTitle>Heure+</AssemblyTitle>
    <NeutralLanguage>fr-FR</NeutralLanguage>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>heureplus.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Aussi embarqué comme ressource pour l'icône de fenêtre / barre des tâches -->
    <Resource Include="heureplus.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Base de données locale chiffrée : SQLCipher (SQLite + AES-256), natif embarqué,
         aucune install requise. Le .Core évite le bundle e_sqlite3 par défaut ;
         bundle_e_sqlcipher fournit le moteur chiffrant. -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="8.0.10" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.10" />
    <!-- Export Excel (.xlsx) — 100% managé, hors ligne -->
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <!-- Export PDF — police embarquée, aucune dépendance système -->
    <PackageReference Include="QuestPDF" Version="2024.10.3" />
  </ItemGroup>

</Project>
