<UserControl x:Class="HeurePlus.Views.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:HeurePlus.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:CalendarViewModel}">

    <Grid Style="{StaticResource PageRoot}" Margin="32,26,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barre d'outils -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource RoundIconButton}" Command="{Binding PrevMonthCommand}" Content="&#xE76B;" />
                <TextBlock Text="{Binding MonthLabel}" Style="{StaticResource PageTitle}"
                           VerticalAlignment="Center" Margin="12,0" MinWidth="230" />
                <Button Style="{StaticResource RoundIconButton}" Command="{Binding NextMonthCommand}" Content="&#xE76C;" />
                <Button Style="{StaticResource SubtleButton}" Command="{Binding TodayCommand}"
                        Content="Aujourd'hui" Margin="10,0,0,0" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource AccentButton}" Command="{Binding AddEntryCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource Font.Icons}" Text="&#xE710;" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="Ajouter une journée" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource GhostButton}" Command="{Binding AddPeriodCommand}"
                        Content="Période" Margin="8,0,0,0" />
                <Button Style="{StaticResource GhostButton}" Command="{Binding AddCycleCommand}"
                        Content="Cycle" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>

        <!-- En-têtes des jours -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding WeekdayHeaders}" Margin="2,0,2,8">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="7" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.TextTertiary}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Grille du mois -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="10">
            <ItemsControl ItemsSource="{Binding Days}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="6" Columns="7" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource DayCellButton}"
                                Command="{Binding DataContext.SelectDayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Panneau de détails -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,16,0,0" MinHeight="128"
                DataContext="{Binding Details}">
            <Grid>
                <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock FontFamily="{StaticResource Font.Icons}" Text="&#xE787;" FontSize="22"
                               HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextTertiary}" />
                    <TextBlock Text="Sélectionnez un jour pour voir et gérer ses détails."
                               Style="{StaticResource Muted}" Margin="0,8,0,0" HorizontalAlignment="Center" />
                </StackPanel>

                <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{Binding DateLabel}" Style="{StaticResource SectionTitle}" Margin="0" />
                            <Border Style="{StaticResource Chip}" Margin="0,10,0,0" HorizontalAlignment="Left"
                                    Background="{Binding StatusKey, Converter={StaticResource StatusToBrush}}"
                                    Visibility="{Binding HasEntry, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding StatusLabel}" Foreground="White" FontWeight="SemiBold" FontSize="12" />
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button Style="{StaticResource AccentButton}" Content="Modifier"
                                    Command="{Binding DataContext.EditSelectedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            <Button Style="{StaticResource GhostButton}" Content="Supprimer" Margin="8,0,0,0"
                                    Foreground="{DynamicResource Brush.Danger}"
                                    Command="{Binding DataContext.DeleteSelectedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource Chip}" Margin="0,14,0,0" Padding="12,8"
                            Background="{DynamicResource Brush.AccentSoft}"
                            Visibility="{Binding IsInCycle, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <TextBlock Text="{Binding CycleLabel}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.AccentSoftText}" />
                            <Button Style="{StaticResource GhostButton}" Content="Modifier le cycle" HorizontalAlignment="Right"
                                    MinHeight="30" Padding="12,0"
                                    Command="{Binding DataContext.EditCycleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </Grid>
                    </Border>

                    <Grid Margin="0,18,0,0" Visibility="{Binding HasEntry, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="HEURES" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{Binding HoursLabel}" Style="{StaticResource BodyStrong}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="HORAIRE" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{Binding ScheduleLabel}" Style="{StaticResource BodyStrong}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="TAUX HORAIRE" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{Binding RateLabel}" Style="{StaticResource BodyStrong}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,14,0,0" Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="NOTE" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding Note}" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Margin="0,14,0,0" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Aucune saisie pour ce jour." Style="{StaticResource Muted}" />
                        <Button Style="{StaticResource AccentButton}" Content="Ajouter une saisie" Margin="0,10,0,0"
                                HorizontalAlignment="Left"
                                Command="{Binding DataContext.EditSelectedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
