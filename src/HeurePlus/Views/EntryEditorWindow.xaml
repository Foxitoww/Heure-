<Window x:Class="HeurePlus.Views.EntryEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:HeurePlus.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:EntryEditorViewModel}"
        Title="{Binding Title}" Height="660" Width="540"
        Icon="/HeurePlus;component/heureplus.ico"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FontFamily="{StaticResource Font.Text}" FontSize="14" Language="fr-FR"
        Background="{DynamicResource Brush.Bg}"
        TextElement.Foreground="{DynamicResource Brush.Text}"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

    <Grid Margin="26,24,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" Style="{StaticResource PageTitle}" FontSize="22" Margin="0,0,0,18" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <RadioButton Content="Une journée" GroupName="Kind" Margin="0,0,24,0"
                                 IsChecked="{Binding IsPeriod, Converter={StaticResource InvBool}}" />
                    <RadioButton Content="Une période" GroupName="Kind" IsChecked="{Binding IsPeriod}" />
                </StackPanel>

                <StackPanel Visibility="{Binding IsSingleDay, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="DATE" Style="{StaticResource FieldLabel}" />
                    <DatePicker SelectedDate="{Binding Date}" Width="200" HorizontalAlignment="Left" Margin="0,0,0,4" />
                </StackPanel>

                <StackPanel Visibility="{Binding IsPeriod, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="DU" Style="{StaticResource FieldLabel}" />
                            <DatePicker SelectedDate="{Binding StartDate}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="AU" Style="{StaticResource FieldLabel}" />
                            <DatePicker SelectedDate="{Binding EndDate}" />
                        </StackPanel>
                    </Grid>
                    <CheckBox Content="Inclure les samedis et dimanches" IsChecked="{Binding IncludeWeekends}" Margin="0,12,0,0" />
                    <CheckBox Content="Écraser les saisies déjà présentes" IsChecked="{Binding OverwriteExisting}" />
                    <Border Style="{StaticResource Divider}" />
                </StackPanel>

                <TextBlock Text="STATUT" Style="{StaticResource FieldLabel}" Margin="0,6,0,5" />
                <ComboBox ItemsSource="{Binding StatusOptions}" SelectedValuePath="Value"
                          SelectedValue="{Binding Status}" Width="220" HorizontalAlignment="Left" Margin="0,0,0,16">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Grid IsEnabled="{Binding HoursEnabled}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="DÉBUT" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding StartText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="FIN" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding EndText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="PAUSE (MIN)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding BreakMinutes}" />
                    </StackPanel>
                </Grid>

                <Button Style="{StaticResource SubtleButton}" HorizontalAlignment="Left" Margin="0,10,0,0"
                        IsEnabled="{Binding HoursEnabled}" Command="{Binding ComputeFromScheduleCommand}"
                        Content="Calculer les heures depuis les horaires" />

                <Grid Margin="0,14,0,0" IsEnabled="{Binding HoursEnabled}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="HEURES NORMALES" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding NormalHours}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="HEURES SUPPLÉMENTAIRES" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding OvertimeHours}" />
                    </StackPanel>
                </Grid>

                <CheckBox Content="Taux horaire spécifique pour cette saisie" IsChecked="{Binding UseCustomRate}" Margin="0,16,0,0" />
                <TextBox Text="{Binding CustomRate}" IsEnabled="{Binding UseCustomRate}" Width="150" HorizontalAlignment="Left" Margin="0,4,0,0" />

                <TextBlock Text="NOTE" Style="{StaticResource FieldLabel}" Margin="0,16,0,5" />
                <TextBox Text="{Binding Note}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70"
                         VerticalContentAlignment="Top" Padding="10,8" VerticalScrollBarVisibility="Auto" />

                <Border Margin="0,14,0,0" CornerRadius="6" Padding="12,10"
                        Background="{DynamicResource Brush.DangerSoft}"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Style="{StaticResource SubtleButton}" Content="Annuler" Command="{Binding CancelCommand}" />
            <Button Style="{StaticResource AccentButton}" Content="Enregistrer" Margin="10,0,0,0" Command="{Binding SaveCommand}" />
        </StackPanel>
    </Grid>
</Window>
