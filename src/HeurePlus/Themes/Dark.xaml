<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================= Thème sombre ================= -->

    <Color x:Key="Color.Bg">#FF14161C</Color>
    <Color x:Key="Color.Surface">#FF1E212B</Color>
    <Color x:Key="Color.SurfaceAlt">#FF262A36</Color>
    <Color x:Key="Color.Border">#FF333846</Color>
    <Color x:Key="Color.Text">#FFE6E8EE</Color>
    <Color x:Key="Color.TextMuted">#FF9AA1AE</Color>
    <Color x:Key="Color.Accent">#FF7C83FF</Color>
    <Color x:Key="Color.AccentText">#FF14161C</Color>
    <Color x:Key="Color.Shadow">#66000000</Color>

    <SolidColorBrush x:Key="Brush.Bg" Color="{StaticResource Color.Bg}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="{StaticResource Color.SurfaceAlt}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="{StaticResource Color.AccentText}" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#FF2E3350" />
    <SolidColorBrush x:Key="Brush.ChartBar" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.ChartTrack" Color="#FF2B2F3B" />

</ResourceDictionary>
