<UserControl x:Class="HeurePlus.Views.SalaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:HeurePlus.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SalaryViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20" MaxWidth="1000" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="Salaire" Style="{StaticResource PageTitle}" Margin="0,0,0,16" />

            <!-- ======= Paramètres ======= -->
            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Paramètres de calcul" Style="{StaticResource SectionTitle}" />

                    <TextBlock Text="Taux horaire brut" Style="{StaticResource KpiLabel}" />
                    <TextBox Text="{Binding HourlyRate}" Width="160" HorizontalAlignment="Left" Margin="0,2,0,12" />

                    <TextBlock Text="Coefficient des heures supplémentaires (1,25 = +25 %)" Style="{StaticResource KpiLabel}" />
                    <TextBox Text="{Binding OvertimeMultiplier}" Width="160" HorizontalAlignment="Left" Margin="0,2,0,12" />

                    <CheckBox Content="Indemnité de fin de mission (IFM / prime de précarité)" IsChecked="{Binding ApplyIfm}" />
                    <StackPanel Orientation="Horizontal" Margin="24,4,0,12" IsEnabled="{Binding ApplyIfm}">
                        <TextBox Text="{Binding IfmPercent}" Width="80" />
                        <TextBlock Text=" %" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>

                    <CheckBox Content="Indemnité compensatrice de congés payés (ICP)" IsChecked="{Binding ApplyIcp}" />
                    <StackPanel Orientation="Horizontal" Margin="24,4,0,12" IsEnabled="{Binding ApplyIcp}">
                        <TextBox Text="{Binding IcpPercent}" Width="80" />
                        <TextBlock Text=" %" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Durée hebdo. de référence" Style="{StaticResource KpiLabel}" />
                            <TextBox Text="{Binding WeeklyHours}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Devise" Style="{StaticResource KpiLabel}" />
                            <TextBox Text="{Binding Currency}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Style="{StaticResource AccentButton}" Content="Enregistrer" Command="{Binding SaveCommand}" />
                        <Button Style="{StaticResource GhostButton}" Content="Réinitialiser" Margin="10,0,0,0" Command="{Binding ResetCommand}" />
                    </StackPanel>

                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Muted}" Margin="0,10,0,0"
                               Visibility="{Binding StatusMessage, Converter={StaticResource NullOrEmptyToVis}}" />
                </StackPanel>
            </Border>

            <!-- ======= Estimation ======= -->
            <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Estimation du salaire" Style="{StaticResource SectionTitle}" />

                    <ComboBox ItemsSource="{Binding ScopeOptions}" SelectedItem="{Binding SelectedScope}" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding ScopeLabel}" Style="{StaticResource Muted}" Margin="0,0,0,14" />

                    <Grid Margin="0,2">
                        <TextBlock Text="Heures normales" Foreground="{DynamicResource Brush.TextMuted}" />
                        <TextBlock Text="{Binding NormalHoursText}" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Margin="0,2,0,8">
                        <TextBlock Text="  → rémunération" Foreground="{DynamicResource Brush.TextMuted}" />
                        <TextBlock Text="{Binding NormalPayText}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                    </Grid>

                    <Grid Margin="0,2">
                        <TextBlock Text="Heures supplémentaires" Foreground="{DynamicResource Brush.TextMuted}" />
                        <TextBlock Text="{Binding OvertimeHoursText}" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Margin="0,2,0,8">
                        <TextBlock Text="  → rémunération majorée" Foreground="{DynamicResource Brush.TextMuted}" />
                        <TextBlock Text="{Binding OvertimePayText}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                    </Grid>

                    <Rectangle Height="1" Fill="{DynamicResource Brush.Border}" Margin="0,6" />

                    <Grid Margin="0,2">
                        <TextBlock Text="Brut estimé" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding GrossText}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                    </Grid>
                    <Grid Margin="0,2" Visibility="{Binding ShowIfm, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="+ IFM" Foreground="{DynamicResource Brush.TextMuted}" />
                        <TextBlock Text="{Binding IfmText}" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Margin="0,2" Visibility="{Binding ShowIcp, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="+ Congés payés" Foreground="{DynamicResource Brush.TextMuted}" />
                        <TextBlock Text="{Binding IcpText}" HorizontalAlignment="Right" />
                    </Grid>

                    <Border Background="{DynamicResource Brush.AccentSoft}" CornerRadius="10" Padding="12" Margin="0,12,0,0">
                        <Grid>
                            <TextBlock Text="Total estimé" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TotalText}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="18"
                                       Foreground="{DynamicResource Brush.Accent}" />
                        </Grid>
                    </Border>

                    <TextBlock Style="{StaticResource Muted}" Margin="0,12,0,0" TextWrapping="Wrap"
                               Text="Estimation indicative basée sur vos saisies et vos paramètres. Ne remplace pas un bulletin de paie." />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
