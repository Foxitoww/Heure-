<Window x:Class="HeurePlus.Views.ProfilePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:HeurePlus.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:ProfilePickerViewModel}"
        Title="Heure+" Height="600" Width="800"
        Icon="/HeurePlus;component/heureplus.ico"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        FontFamily="{StaticResource Font.Text}" FontSize="14" Language="fr-FR"
        Background="{DynamicResource Brush.Bg}"
        TextElement.Foreground="{DynamicResource Brush.Text}"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

    <Grid Background="{DynamicResource Brush.Bg}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" FontSize="26"
                       HorizontalAlignment="Center" Margin="0,0,0,28" />

            <ItemsControl ItemsSource="{Binding Cards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center" MaxWidth="620" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="12">
                            <Button Style="{StaticResource PlainButton}"
                                    Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <StackPanel Width="132">
                                    <Border Width="132" Height="132" CornerRadius="18">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{Binding ColorHex, Converter={StaticResource HexToBrush}}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAddCard}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.CardStroke}" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Initial}" FontWeight="SemiBold"
                                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontSize" Value="46" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAddCard}" Value="True">
                                                            <Setter Property="FontSize" Value="34" />
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrong}"
                                               HorizontalAlignment="Center" TextAlignment="Center" Margin="0,10,0,0"
                                               MaxWidth="132" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="&#xE72E;" FontFamily="{StaticResource Font.Icons}" FontSize="11"
                                               Foreground="{DynamicResource Brush.TextTertiary}" HorizontalAlignment="Center"
                                               Visibility="{Binding Protected, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Button>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Margin="0,4,4,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding DataContext.ManageMode, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True" />
                                                    <Condition Binding="{Binding IsAddCard}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Button Style="{StaticResource RoundIconButton}" Width="26" Height="26"
                                        Content="&#xE70F;" ToolTip="Modifier"
                                        Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" />
                                <Button Style="{StaticResource RoundIconButton}" Width="26" Height="26"
                                        Content="&#xE74D;" ToolTip="Supprimer"
                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Style="{StaticResource SubtleButton}" Content="Gérer les profils"
                    Command="{Binding ToggleManageCommand}" HorizontalAlignment="Center" Margin="0,24,0,0" />

        </StackPanel>
    </Grid>
</Window>
