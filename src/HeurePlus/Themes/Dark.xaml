<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Heure+ · Theme SOMBRE — inspire Fluent Design / Windows 11. -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="Brush.Bg"          Color="#1F1F1F" />
    <SolidColorBrush x:Key="Brush.NavRailBg"   Color="#1A1A1A" />
    <SolidColorBrush x:Key="Brush.Layer"       Color="#242424" />
    <SolidColorBrush x:Key="Brush.Surface"     Color="#2B2B2B" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt"  Color="#333333" />
    <SolidColorBrush x:Key="Brush.SurfaceInput" Color="#303030" />

    <!-- Traits -->
    <SolidColorBrush x:Key="Brush.Border"              Color="#3A3A3A" />
    <SolidColorBrush x:Key="Brush.CardStroke"          Color="#383838" />
    <SolidColorBrush x:Key="Brush.DividerStroke"       Color="#343434" />
    <SolidColorBrush x:Key="Brush.ControlStroke"       Color="#3D3D3D" />
    <SolidColorBrush x:Key="Brush.ControlStrokeStrong" Color="#484848" />
    <SolidColorBrush x:Key="Brush.FocusStroke"         Color="#FFFFFF" />

    <!-- Texte -->
    <SolidColorBrush x:Key="Brush.Text"         Color="#F4F4F4" />
    <SolidColorBrush x:Key="Brush.TextMuted"    Color="#C6C6C6" />
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="#9A9A9A" />
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="#787878" />

    <!-- Remplissages de controles -->
    <SolidColorBrush x:Key="Brush.ControlFill"         Color="#323232" />
    <SolidColorBrush x:Key="Brush.ControlFillHover"    Color="#3A3A3A" />
    <SolidColorBrush x:Key="Brush.ControlFillPressed"  Color="#2E2E2E" />
    <SolidColorBrush x:Key="Brush.ControlFillDisabled" Color="#2A2A2A" />

    <!-- Superpositions translucides -->
    <SolidColorBrush x:Key="Brush.SubtleHover"    Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Brush.SubtlePressed"  Color="#0BFFFFFF" />
    <SolidColorBrush x:Key="Brush.SubtleSelected" Color="#1FFFFFFF" />

    <!-- Accent (Windows 11 eclaircit l'accent en sombre) -->
    <SolidColorBrush x:Key="Brush.Accent"             Color="#4CA0E0" />
    <SolidColorBrush x:Key="Brush.AccentHover"        Color="#63B0E8" />
    <SolidColorBrush x:Key="Brush.AccentPressed"      Color="#3E8AC6" />
    <SolidColorBrush x:Key="Brush.AccentText"         Color="#1B1B1B" />
    <SolidColorBrush x:Key="Brush.AccentDisabledFill" Color="#3A3A3A" />
    <SolidColorBrush x:Key="Brush.AccentTextDisabled" Color="#7C7C7C" />
    <SolidColorBrush x:Key="Brush.AccentSoft"         Color="#20344A" />
    <SolidColorBrush x:Key="Brush.AccentSoftText"     Color="#8FC5EE" />

    <!-- Graphiques -->
    <SolidColorBrush x:Key="Brush.ChartBar"    Color="#4CA0E0" />
    <SolidColorBrush x:Key="Brush.ChartBarAlt" Color="#356F9C" />
    <SolidColorBrush x:Key="Brush.ChartTrack"  Color="#343434" />
    <SolidColorBrush x:Key="Brush.ChartGrid"   Color="#343434" />

    <!-- Semantique -->
    <SolidColorBrush x:Key="Brush.Danger"     Color="#FF99A4" />
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="#3A2523" />
    <SolidColorBrush x:Key="Brush.Success"    Color="#6CCB70" />

    <!-- Ombres -->
    <Color x:Key="Color.Shadow">#8C000000</Color>

</ResourceDictionary>
