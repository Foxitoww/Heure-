<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================= Thème clair ================= -->

    <Color x:Key="Color.Bg">#FFF4F5FA</Color>
    <Color x:Key="Color.Surface">#FFFFFFFF</Color>
    <Color x:Key="Color.SurfaceAlt">#FFEDEFF6</Color>
    <Color x:Key="Color.Border">#FFE1E4EC</Color>
    <Color x:Key="Color.Text">#FF1F2430</Color>
    <Color x:Key="Color.TextMuted">#FF6B7280</Color>
    <Color x:Key="Color.Accent">#FF6366F1</Color>
    <Color x:Key="Color.AccentText">#FFFFFFFF</Color>
    <Color x:Key="Color.Shadow">#33334155</Color>

    <SolidColorBrush x:Key="Brush.Bg" Color="{StaticResource Color.Bg}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="{StaticResource Color.SurfaceAlt}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="{StaticResource Color.AccentText}" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#FFE0E1FB" />
    <SolidColorBrush x:Key="Brush.ChartBar" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.ChartTrack" Color="#FFE9EBF3" />

</ResourceDictionary>
