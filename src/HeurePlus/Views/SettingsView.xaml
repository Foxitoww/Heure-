<UserControl x:Class="HeurePlus.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:HeurePlus.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}">

    <Grid Style="{StaticResource PageRoot}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
            <StackPanel Margin="32,26,32,32" MaxWidth="820" HorizontalAlignment="Left">

                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="Réglages" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Apparence, sauvegarde des données et exports." Style="{StaticResource PageSubtitle}" />
                </StackPanel>

                <!-- Apparence -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Apparence" Style="{StaticResource SectionTitle}" />

                        <Grid Margin="0,2">
                            <StackPanel>
                                <TextBlock Text="Thème sombre" Style="{StaticResource BodyStrong}" />
                                <TextBlock Text="Bascule entre le thème clair et le thème sombre." Style="{StaticResource Caption}" Margin="0,2,0,0" />
                            </StackPanel>
                            <ToggleButton Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          IsChecked="{Binding IsDark}" />
                        </Grid>

                        <Border Style="{StaticResource Divider}" />

                        <TextBlock Text="Premier jour de la semaine" Style="{StaticResource BodyStrong}" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Lundi" GroupName="WeekStart" Margin="0,0,24,0"
                                         IsChecked="{Binding WeekStartsMonday}" />
                            <RadioButton Content="Dimanche" GroupName="WeekStart"
                                         IsChecked="{Binding WeekStartsMonday, Converter={StaticResource InvBool}}" />
                        </StackPanel>

                        <Border Style="{StaticResource Divider}" />

                        <TextBlock Text="Devise" Style="{StaticResource BodyStrong}" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding Currency}" Width="120" />
                            <Button Style="{StaticResource GhostButton}" Content="Enregistrer" Margin="10,0,0,0"
                                    Command="{Binding SaveCurrencyCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Sauvegarde -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Sauvegarde" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Text="Toutes les données sont stockées localement dans un fichier SQLite. Aucune connexion Internet n'est utilisée." />

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Style="{StaticResource AccentButton}" Content="Sauvegarder maintenant"
                                    Command="{Binding BackupNowCommand}" />
                            <Button Style="{StaticResource GhostButton}" Content="Restaurer une sauvegarde" Margin="10,0,0,0"
                                    Command="{Binding RestoreCommand}" />
                            <Button Style="{StaticResource SubtleButton}" Content="Ouvrir le dossier" Margin="6,0,0,0"
                                    Command="{Binding OpenDbFolderCommand}" />
                        </StackPanel>

                        <TextBlock Text="{Binding LastBackupText}" Style="{StaticResource Caption}" Margin="0,12,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Export -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Export" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="MOIS À EXPORTER" Style="{StaticResource FieldLabel}" />
                        <DatePicker SelectedDate="{Binding ExportMonth}" Width="200" HorizontalAlignment="Left" />

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Style="{StaticResource AccentButton}" Content="Exporter en PDF" Command="{Binding ExportPdfCommand}" />
                            <Button Style="{StaticResource GhostButton}" Content="Exporter en Excel" Margin="10,0,0,0"
                                    Command="{Binding ExportExcelCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Mise à jour -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Mise à jour" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Text="Récupère la dernière version depuis le dépôt git (branche 0.1). Fonctionne quand l'application est lancée depuis les sources." />

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Style="{StaticResource AccentButton}" Content="Vérifier les mises à jour"
                                    Command="{Binding CheckUpdateCommand}" />
                            <Button Style="{StaticResource GhostButton}" Content="Mettre à jour" Margin="10,0,0,0"
                                    Command="{Binding ApplyUpdateCommand}"
                                    Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>

                        <TextBlock Text="{Binding UpdateInfoText}" Style="{StaticResource Muted}" Margin="0,12,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding UpdateDetailText}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                   Visibility="{Binding UpdateDetailText, Converter={StaticResource NullOrEmptyToVis}}" />
                    </StackPanel>
                </Border>

                <!-- À propos -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="À propos" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Heure+ — calendrier pour travailleurs intérimaires" Style="{StaticResource BodyStrong}" />
                        <TextBlock Text="{Binding VersionText}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap">
                            <Run Text="Base de données : " />
                            <Run Text="{Binding DbPath, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardAccent}" Padding="12,10" Margin="0,16,0,0"
                        Visibility="{Binding StatusMessage, Converter={StaticResource NullOrEmptyToVis}}">
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.AccentSoftText}" />
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
