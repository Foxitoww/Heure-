<Window x:Class="HeurePlus.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:HeurePlus.Views"
        Title="Heure+" Height="840" Width="1200" MinHeight="640" MinWidth="980"
        Icon="/HeurePlus;component/heureplus.ico"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13" Language="fr-FR"
        Background="{DynamicResource Brush.Bg}"
        TextElement.Foreground="{DynamicResource Brush.Text}"
        TextOptions.TextFormattingMode="Ideal">

    <TabControl Style="{DynamicResource ModernTabControl}" SelectedIndex="{Binding SelectedTab}">
        <TabItem Header="Calendrier">
            <views:CalendarView DataContext="{Binding Calendar}" />
        </TabItem>
        <TabItem Header="Salaire">
            <views:SalaryView DataContext="{Binding Salary}" />
        </TabItem>
        <TabItem Header="Calculatrice">
            <views:CalculatorView DataContext="{Binding Calculator}" />
        </TabItem>
        <TabItem Header="Tableau de bord">
            <views:DashboardView DataContext="{Binding Dashboard}" />
        </TabItem>
        <TabItem Header="Réglages">
            <views:SettingsView DataContext="{Binding Settings}" />
        </TabItem>
    </TabControl>
</Window>
