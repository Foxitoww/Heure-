                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Pill" Storyboard.TargetProperty="Height"
                                                         To="18" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
