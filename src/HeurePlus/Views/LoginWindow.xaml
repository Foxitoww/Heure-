<Window x:Class="HeurePlus.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:HeurePlus.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:LoginViewModel}"
        Title="Connexion" Height="400" Width="430"
        Icon="/HeurePlus;component/heureplus.ico"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        FontFamily="{StaticResource Font.Text}" FontSize="14" Language="fr-FR"
        Background="{DynamicResource Brush.Bg}"
        TextElement.Foreground="{DynamicResource Brush.Text}"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

    <StackPanel Margin="28">
        <TextBlock Text="{Binding Heading}" Style="{StaticResource PageTitle}" FontSize="20" Margin="0,0,0,18" />

        <TextBlock Text="IDENTIFIANT" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

        <TextBlock Text="MOT DE PASSE" Style="{StaticResource FieldLabel}" />
        <PasswordBox x:Name="Pw" KeyDown="OnPasswordKeyDown" Margin="0,0,0,12" />

        <CheckBox Content="Se souvenir de moi sur cet appareil" IsChecked="{Binding RememberMe}" />

        <Border CornerRadius="6" Padding="12,10" Margin="0,14,0,0"
                Background="{DynamicResource Brush.DangerSoft}"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Style="{StaticResource SubtleButton}" Content="Annuler" Command="{Binding CancelCommand}" />
            <Button Style="{StaticResource AccentButton}" Content="Se connecter" Click="OnConnect" Margin="10,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
