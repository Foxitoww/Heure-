<UserControl x:Class="HeurePlus.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:HeurePlus.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DashboardViewModel}">

    <UserControl.Resources>
        <Style x:Key="KpiCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Width" Value="204" />
            <Setter Property="Margin" Value="0,0,16,16" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <DataTemplate x:Key="BarTemplate">
            <Grid Width="24" Margin="2,0" ToolTip="{Binding Tooltip}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="150" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" CornerRadius="4" Background="{DynamicResource Brush.ChartTrack}" />
                <Border Grid.Row="0" VerticalAlignment="Bottom" Height="{Binding PixelHeight}"
                        CornerRadius="4,4,0,0" Background="{DynamicResource Brush.ChartBar}" />
                <TextBlock Grid.Row="1" Text="{Binding Label}" FontSize="9" HorizontalAlignment="Center"
                           Margin="0,5,0,0" Foreground="{DynamicResource Brush.TextTertiary}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="WeekBarTemplate">
            <Grid Width="76" Margin="8,0" ToolTip="{Binding Tooltip}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="150" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{Binding Value, StringFormat={}{0:0.#} h}" FontSize="11"
                           HorizontalAlignment="Center" Margin="0,0,0,6" Foreground="{DynamicResource Brush.TextMuted}" />
                <Border Grid.Row="1" CornerRadius="6" Background="{DynamicResource Brush.ChartTrack}" />
                <Border Grid.Row="1" VerticalAlignment="Bottom" Height="{Binding PixelHeight}"
                        CornerRadius="6,6,0,0" Background="{DynamicResource Brush.ChartBar}" />
                <TextBlock Grid.Row="2" Text="{Binding Label}" FontSize="12" HorizontalAlignment="Center"
                           Margin="0,7,0,0" Foreground="{DynamicResource Brush.TextTertiary}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Style="{StaticResource PageRoot}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
            <Grid Margin="32,26,32,32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- En-tête -->
                <Grid Grid.Row="0" Margin="0,0,0,22">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Tableau de bord" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="Synthèse du mois et tendances." Style="{StaticResource PageSubtitle}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource RoundIconButton}" Command="{Binding PrevMonthCommand}" Content="&#xE76B;" />
                        <TextBlock Text="{Binding MonthLabel}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Margin="12,0" MinWidth="150" TextAlignment="Center" />
                        <Button Style="{StaticResource RoundIconButton}" Command="{Binding NextMonthCommand}" Content="&#xE76C;" />
                        <Button Style="{StaticResource SubtleButton}" Command="{Binding TodayCommand}" Content="Ce mois" Margin="10,0,0,0" />
                    </StackPanel>
                </Grid>

                <!-- Cartes KPI -->
                <WrapPanel Grid.Row="1">
                    <Border Style="{StaticResource KpiCard}">
                        <StackPanel>
                            <TextBlock Text="{Binding TotalHoursText}" Style="{StaticResource KpiValue}" />
                            <TextBlock Text="Heures totales" Style="{StaticResource KpiLabel}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource KpiCard}">
                        <StackPanel>
                            <TextBlock Text="{Binding OvertimeHoursText}" Style="{StaticResource KpiValue}" />
                            <TextBlock Text="Heures supplémentaires" Style="{StaticResource KpiLabel}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource KpiCard}">
                        <StackPanel>
                            <TextBlock Text="{Binding WorkedDaysText}" Style="{StaticResource KpiValue}" />
                            <TextBlock Text="Jours travaillés" Style="{StaticResource KpiLabel}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource KpiCard}">
                        <StackPanel>
                            <TextBlock Text="{Binding LeaveDaysText}" Style="{StaticResource KpiValue}" />
                            <TextBlock Text="Jours de congé" Style="{StaticResource KpiLabel}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource KpiCard}">
                        <StackPanel>
                            <TextBlock Text="{Binding RestDaysText}" Style="{StaticResource KpiValue}" />
                            <TextBlock Text="Jours de repos" Style="{StaticResource KpiLabel}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource KpiCard}">
                        <StackPanel>
                            <TextBlock Text="{Binding AverageDayText}" Style="{StaticResource KpiValue}" />
                            <TextBlock Text="Moyenne / jour travaillé" Style="{StaticResource KpiLabel}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource KpiCard}" Width="264" Background="{DynamicResource Brush.AccentSoft}"
                            BorderBrush="Transparent">
                        <StackPanel>
                            <TextBlock Text="{Binding EstimatedSalaryText}" Style="{StaticResource KpiValue}"
                                       Foreground="{DynamicResource Brush.AccentSoftText}" />
                            <TextBlock Text="Salaire estimé (ce mois)" Style="{StaticResource KpiLabel}"
                                       Foreground="{DynamicResource Brush.AccentSoftText}" />
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- Heures par jour -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,6,0,0">
                    <StackPanel>
                        <TextBlock Text="Heures par jour" Style="{StaticResource SectionTitle}" />
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding DayBars}" ItemTemplate="{StaticResource BarTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <Border Height="1" Background="{DynamicResource Brush.ChartGrid}" Margin="0,2,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                        <TextBlock Text="Aucune donnée pour ce mois." Style="{StaticResource Muted}" Margin="0,10,0,0"
                                   Visibility="{Binding HasData, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                    </StackPanel>
                </Border>

                <!-- Semaine + répartition -->
                <Grid Grid.Row="3" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="1.05*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Heures par semaine" Style="{StaticResource SectionTitle}" />
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding WeekBars}" ItemTemplate="{StaticResource WeekBarTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Répartition des jours" Style="{StaticResource SectionTitle}" />
                            <ItemsControl ItemsSource="{Binding StatusBreakdown}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,7">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="10" Height="10" CornerRadius="3" VerticalAlignment="Center"
                                                        Background="{Binding ColorKey, Converter={StaticResource StatusToBrush}}" />
                                                <TextBlock Text="{Binding Label}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding CountText}" HorizontalAlignment="Right"
                                                       Style="{StaticResource BodyStrong}" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
