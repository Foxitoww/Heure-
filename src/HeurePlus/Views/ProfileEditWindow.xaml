<Window x:Class="HeurePlus.Views.ProfileEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:HeurePlus.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:ProfileEditViewModel}"
        Title="{Binding Heading}" Height="560" Width="470"
        Icon="/HeurePlus;component/heureplus.ico"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        FontFamily="{StaticResource Font.Text}" FontSize="14" Language="fr-FR"
        Background="{DynamicResource Brush.Bg}"
        TextElement.Foreground="{DynamicResource Brush.Text}"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Heading}" Style="{StaticResource PageTitle}" FontSize="20" Margin="0,0,0,18" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel>
                <TextBlock Text="NOM" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                <TextBlock Text="IDENTIFIANT" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                <TextBlock Text="COULEUR" Style="{StaticResource FieldLabel}" />
                <ItemsControl ItemsSource="{Binding Palette}" Margin="0,0,0,6">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="30" Height="30" Margin="0,0,8,8" Style="{StaticResource PlainButton}"
                                    Command="{Binding DataContext.PickColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <Border CornerRadius="15" Background="{Binding Converter={StaticResource HexToBrush}}" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Visibility="{Binding ShowPasswordFields, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="MOT DE PASSE" Style="{StaticResource FieldLabel}" />
                    <PasswordBox x:Name="Pw" Margin="0,0,0,12" />
                    <TextBlock Text="CONFIRMER" Style="{StaticResource FieldLabel}" />
                    <PasswordBox x:Name="Pw2" Margin="0,0,0,12" />
                </StackPanel>

                <CheckBox Content="Changer le mot de passe" IsChecked="{Binding ChangePassword}"
                          Visibility="{Binding CanChangePassword, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0" />

                <CheckBox Content="Rester connecté sur cet appareil" IsChecked="{Binding RememberMe}"
                          Visibility="{Binding AlwaysAskPassword, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0" />

                <Border CornerRadius="6" Padding="12,10" Margin="0,14,0,0"
                        Background="{DynamicResource Brush.DangerSoft}"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Style="{StaticResource SubtleButton}" Content="Supprimer ce profil"
                    HorizontalAlignment="Left" Foreground="{DynamicResource Brush.Danger}"
                    Command="{Binding DeleteCommand}"
                    Visibility="{Binding CanDelete, Converter={StaticResource BoolToVis}}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SubtleButton}" Content="Annuler" Command="{Binding CancelCommand}" />
                <Button Style="{StaticResource AccentButton}" Content="Enregistrer" Click="OnSave" Margin="10,0,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
